<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tenx-AI Zenith</title>
    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            display: flex;
            flex-direction: column;
            height: 100vh;
        }
        header {
            background: #1e293b;
            padding: 1rem;
            text-align: center;
            font-size: 1.5rem;
            font-weight: bold;
            border-bottom: 1px solid #334155;
            letter-spacing: 1px;
        }
        #chat-container {
            flex: 1;
            overflow-y: auto;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            max-width: 800px;
            margin: 0 auto;
            width: 100%;
            box-sizing: border-box;
        }
        .message {
            padding: 0.85rem 1.2rem;
            border-radius: 0.75rem;
            max-width: 75%;
            line-height: 1.6;
            word-wrap: break-word;
        }
        .user-message {
            background: #3b82f6;
            color: white;
            align-self: flex-start;
            border-bottom-right-radius: 0.2rem;
        }
        .ai-message {
            background: #1e293b;
            color: #e2e8f0;
            align-self: flex-end;
            border: 1px solid #334155;
            border-bottom-left-radius: 0.2rem;
        }
        #input-container {
            background: #1e293b;
            padding: 1rem;
            display: flex;
            gap: 0.75rem;
            max-width: 800px;
            margin: 0 auto;
            width: 100%;
            box-sizing: border-box;
            border-top: 1px solid #334155;
        }
        input[type="text"] {
            flex: 1;
            padding: 0.85rem;
            border-radius: 0.5rem;
            border: 1px solid #475569;
            background: #0f172a;
            color: white;
            outline: none;
            font-size: 1rem;
        }
        input[type="text"]:focus {
            border-color: #3b82f6;
        }
        button {
            background: #6366f1;
            color: white;
            border: none;
            padding: 0 1.5rem;
            border-radius: 0.5rem;
            cursor: pointer;
            font-weight: bold;
            font-size: 1rem;
            transition: background 0.2s;
        }
        button:hover {
            background: #4f46e5;
        }
    </style>
</head>
<body>
    <header>Tenx-AI Zenith 🚀</header>
    
    <div id="chat-container">
        <div class="message ai-message">أهلاً بك! أنا نظام Tenx-AI Zenith الذكي، كيف يمكنني مساعدتك في مشروعك اليوم؟</div>
    </div>

    <div id="input-container">
        <input type="text" id="user-input" placeholder="اكتب رسالتك هنا..." onkeydown="if(event.key==='Enter') sendMessage()">
        <button onclick="sendMessage()">إرسال</button>
    </div>

    <script>
        async function sendMessage() {
            const inputField = document.getElementById('user-input');
            const chatContainer = document.getElementById('chat-container');
            const messageText = inputField.value.trim();
            
            if (!messageText) return;

            // عرض رسالة المستخدم
            const userDiv = document.createElement('div');
            userDiv.className = 'message user-message';
            userDiv.textContent = messageText;
            chatContainer.appendChild(userDiv);
            
            inputField.value = '';
            chatContainer.scrollTop = chatContainer.scrollHeight;

            // عرض حالة الانتظار
            const aiDiv = document.createElement('div');
            aiDiv.className = 'message ai-message';
            aiDiv.textContent = 'جاري التفكير...';
            chatContainer.appendChild(aiDiv);
            chatContainer.scrollTop = chatContainer.scrollHeight;

            try {
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: messageText })
                });
                
                const data = await response.json();
                
                if (response.ok) {
                    aiDiv.textContent = data.reply;
                } else {
                    aiDiv.textContent = 'خطأ: ' + (data.error || 'حدث خطأ ما في المعالجة.');
                }
            } catch (error) {
                aiDiv.textContent = 'حدث خطأ في الاتصال بالخادم.';
            }
            
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }
    </script>
</body>
</html>
